resource rTextForLETextBox2(0x42003, $0000) {
    TBForeColor TBColor7
    "Reliefware"
    TBForeColor TBColor0
    " is like Shareware,\n"
    "  except that all money goes to homeless\n"
    "  relief efforts.  The author keeps NONE\n"
    "  of the money.\n"
    "Try "
    TBForeColor TBColor5
    "Milestones 2000"
    TBForeColor TBColor0
    " for 3 days.\n"
    "  If you keep it, send $15 to the address\n"
    "  in the 'About...' box. If not, please\n"
    "  delete it or pass it on to a friend.\n"
    "You are blessed - you have an address,\n"
    "  a roof, and a computer.  Please help\n"
    "  those who don't.  THANKS!"
};

resource rTextForLETextBox2(0x42004, $0000) {
    "The "
    TBForeColor TBColor7
    "Object of the Game"
    TBForeColor TBColor0
    " is to score\n"
    "  5000 points by competing in a series\n"
    "  of road rallies.  Your Apple ][gs is\n"
    "  your opponent.\n"
    "You use a special deck of cards to play\n"
    "  Milestones 2000.  There are Distance\n"
    "  cards, Fix cards, and Power cards to \n"
    "  aid your cause, and Problem cards to\n"
    "  hinder your opponent. "
};

resource rTextForLETextBox2(0x42005, $0000) {
    "A "
    TBForeColor TBColor7
    "Rally"
    TBForeColor TBColor0
    " is a race of 1500 to 2000\n"
    "  kilometers.  Once you get a green light\n"
    "  (by playing a "
    TBForeColor TBColor5
    "Go!"
    TBForeColor TBColor0
    " card), you play\n"
    "  distance cards until your opponent\n"
    "  stops you with a Problem.  If he does,\n"
    "  you must Fix the Problem and play\n"
    "  another "
    TBForeColor TBColor5
    "Go!"
    TBForeColor TBColor0
    " card before\n"
    "  proceeding."
};

resource rTextForLETextBox2(0x42006, $0000) {
    TBForeColor TBColor7
    "The deck of cards:"
    TBForeColor TBColor0
    "\n"
    "  46 Distance Cards\n"
    "  13 Problem Cards\n"
    "  38 Fix Cards\n"
    "    4 Power Cards\n"
    " ---\n"
    "101 Cards in the deck\n"
    "\n"
    "Each type of card is explained in\n"
    "  detail in the following screens.\n"
    "  "
};

resource rTextForLETextBox2(0x42007, $0000) {
    TBForeColor TBColor4
    "Distance Cards"
    TBForeColor TBColor0
    " have a milepost on\n"
    "  them.  There are ten each of "
    TBForeColor TBColor4
    "50km"
    TBForeColor TBColor0
    ",\n"
    "  "
    TBForeColor TBColor4
    "100km"
    TBForeColor TBColor0
    ", and "
    TBForeColor TBColor4
    "150km"
    TBForeColor TBColor0
    "; twelve "
    TBForeColor TBColor4
    "200km"
    TBForeColor TBColor0
    ";\n"
    "  and four "
    TBForeColor TBColor4
    "400km"
    TBForeColor TBColor0
    ".  Playing one on yourself\n"
    "  moves you forward.\n"
    "The "
    TBForeColor TBColor4
    "400km"
    TBForeColor TBColor0
    " cards are so powerful,\n"
    "  that you are limited to playing up to\n"
    "  two in a single rally.\n"
    "There is a Safe Trip bonus for finishing\n"
    "  a rally without playing any "
    TBForeColor TBColor4
    "400km"
    TBForeColor TBColor0
    "\n"
    "  cards (see How to Score).           "
};

resource rTextForLETextBox2(0x42008, $0000) {
    "There are 14 "
    TBForeColor TBColor5
    "Go!"
    TBForeColor TBColor0
    " cards in the deck.\n"
    "  They are the Fix for the 4 "
    TBForeColor TBColor7
    "Stop!"
    TBForeColor TBColor0
    "\n"
    "  cards.\n"
    "You must play a "
    TBForeColor TBColor5
    "Go!"
    TBForeColor TBColor0
    " card on yourself\n"
    "  before you can play any Distance cards.\n"
    "After Fixing a "
    TBForeColor TBColor7
    "Crash"
    TBForeColor TBColor0
    ", "
    TBForeColor TBColor7
    "Empty"
    TBForeColor TBColor0
    ", or\n"
    "  "
    TBForeColor TBColor7
    "Flat"
    TBForeColor TBColor0
    " Problem, you must play a NEW\n"
    "  "
    TBForeColor TBColor5
    "Go!"
    TBForeColor TBColor0
    " card."
};

resource rTextForLETextBox2(0x42009, $0000) {
    "The "
    TBForeColor TBColor7
    "Speed Limit"
    TBForeColor TBColor0
    " cards are played\n"
    "  on your opponent.  During a speed limit,\n"
    "  only "
    TBForeColor TBColor4
    "50km"
    TBForeColor TBColor0
    " and "
    TBForeColor TBColor4
    "100km"
    TBForeColor TBColor0
    " cards may be\n"
    "  used.  There are three such cards.\n"
    "There are six "
    TBForeColor TBColor5
    "End of Limit"
    TBForeColor TBColor0
    " cards in\n"
    "  the deck.  Play one on yourself to Fix\n"
    "  a "
    TBForeColor TBColor7
    "Speed Limit"
    TBForeColor TBColor0
    ".\n"
    "Unlike other Problems, you can play a\n"
    "  "
    TBForeColor TBColor7
    "Speed Limit"
    TBForeColor TBColor0
    " on your opponent\n"
    "  even if they have another Problem."
};

resource rTextForLETextBox2(0x4200a, $0000) {
    "In addition to "
    TBForeColor TBColor7
    "Stop!"
    TBForeColor TBColor0
    " and "
    TBForeColor TBColor7
    "Speed\n"
    "  Limit"
    TBForeColor TBColor0
    ", there are three other types\n"
    "  of "
    TBForeColor TBColor7
    "Problem Cards"
    TBForeColor TBColor0
    ".  They are\n"
    "  "
    TBForeColor TBColor7
    "Crash"
    TBForeColor TBColor0
    ", "
    TBForeColor TBColor7
    "Empty"
    TBForeColor TBColor0
    ", and "
    TBForeColor TBColor7
    "Flat"
    TBForeColor TBColor0
    ".  The deck\n"
    "  has two each of these Problems.\n"
    "  Problem cards are mostly red.\n"
    "You may only play these Problems on\n"
    "  your opponent when he has a green\n"
    "  light."
};

resource rTextForLETextBox2(0x4200b, $0000) {
    "In addition to "
    TBForeColor TBColor5
    "Go!"
    TBForeColor TBColor0
    " and "
    TBForeColor TBColor5
    "End \n"
    "  Limit"
    TBForeColor TBColor0
    ", there are three other types\n"
    "  of "
    TBForeColor TBColor5
    "Fix Cards"
    TBForeColor TBColor0
    ".  They are "
    TBForeColor TBColor5
    "Repairs"
    TBForeColor TBColor0
    ", \n"
    "  "
    TBForeColor TBColor5
    "Gas"
    TBForeColor TBColor0
    ", and "
    TBForeColor TBColor5
    "Spare"
    TBForeColor TBColor0
    ".  The deck has six of \n"
    "  each of these Fixes, which are mostly\n"
    "  green.\n"
    "You play these on yourself when stopped\n"
    "  by a problem.  Remember, they must be\n"
    "  followed by a "
    TBForeColor TBColor5
    "Go!"
    TBForeColor TBColor0
    " card before\n"
    "  you can start moving again.     "
};

resource rTextForLETextBox2(0x4200c, $0000) {
    "There are 4 unique "
    TBForeColor TBColor3
    "Power Cards"
    TBForeColor TBColor0
    ":\n"
    "  "
    TBForeColor TBColor3
    "Right of Way"
    TBForeColor TBColor0
    ", "
    TBForeColor TBColor3
    "Super Driver"
    TBForeColor TBColor0
    ",\n"
    "  "
    TBForeColor TBColor3
    "Extra Fuel"
    TBForeColor TBColor0
    ", and "
    TBForeColor TBColor3
    "Self-Sealer"
    TBForeColor TBColor0
    ".\n"
    "  They have a rainbow stripe on the left\n"
    "  side.\n"
    "Playing a Power Card not only removes\n"
    "  the corresponding Problem, it provides\n"
    "  a green light and PREVENTS that Problem\n"
    "  for the rest of that rally.\n"
    TBForeColor TBColor3
    "Right of Way"
    TBForeColor TBColor0
    " is also a permanent\n"
    "  "
    TBForeColor TBColor5
    "Go!"
    TBForeColor TBColor0
    " card.\n"
    "Playing a Power Card earns 100 bonus\n"
    "  points and an extra turn.  "
};

resource rTextForLETextBox2(0x4200d, $0000) {
    "In a "
    TBForeColor TBColor7
    "Typical Turn"
    TBForeColor TBColor0
    ", you are dealt\n"
    "  enough cards to bring your hand to 7\n"
    "  cards.  Then you play a card by dragging\n"
    "  it with the mouse.\n"
    "To play a Distance, Fix or Power card on\n"
    "  yourself, release the card over your\n"
    "  "
    TBForeColor TBColor4
    "blue"
    TBForeColor TBColor0
    " car.\n"
    "To play a Problem card on the ][gs,\n"
    "  release it over the "
    TBForeColor TBColor7
    "red"
    TBForeColor TBColor0
    " car.\n"
    "If you have no good play, you must drag\n"
    "  a card to the DISCARD pile. Discards\n"
    "  are out of play for that rally."
};

resource rTextForLETextBox2(0x4200e, $0000) {
    TBForeColor TBColor7
    "Gotchas!"
    TBForeColor TBColor0
    " are a special use of the\n"
    "  Power Cards.  If you are HOLDING a Power\n"
    "  Card when hit with the corresponding\n"
    "  Problem, play the Power Card RIGHT\n"
    "  THEN as a "
    TBForeColor TBColor7
    "Gotcha!"
    TBForeColor TBColor0
    ".\n"
    "You get a 300-point bonus (in addition\n"
    "  to the 100 for playing a Power Card).\n"
    "Playing a Power card after you have had\n"
    "  the problem for more than one turn\n"
    "  does not entitle you to the "
    TBForeColor TBColor7
    "Gotcha!"
    TBForeColor TBColor0
    "\n"
    "  bonus.   "
};

resource rTextForLETextBox2(0x4200f, $0000) {
    TBForeColor TBColor7
    "The Checkpoint"
    TBForeColor TBColor0
    " is at 1500km.\n"
    "  To win a rally, you must reach it\n"
    "  exactly.\n"
    "When you reach 1500km, you can either\n"
    "  end the rally and take a 400-point\n"
    "  bonus, or extend the rally to 2000km\n"
    "  for an extra 200-point bonus.\n"
    "If you extend, and your opponent beats\n"
    "  you to 2000km (or the deck is used up),\n"
    "  you do NOT get the 400-point bonus."
};

resource rTextForLETextBox2(0x42010, $0000) {
    TBForeColor TBColor7
    "A Hand Ends"
    TBForeColor TBColor0
    " when a player reaches\n"
    "  a checkpoint, or the deck is used up\n"
    "  (even if players have playable cards\n"
    "  in their hands).\n"
    "If the deck is used up, neither player\n"
    "  earns finishing or safe-trip bonuses\n"
    "  for that rally."
};

resource rTextForLETextBox2(0x42011, $0000) {
    TBForeColor TBColor7
    "Scoring:"
    TBForeColor TBColor0
    "\n"
    "  1/2 pt  for each km traveled\n"
    "  400 pts for winning at 1500km\n"
    "  600 pts for winning at 2000km\n"
    "  300 pts for a safe trip (no 400kms)\n"
    "  100 pts for each Power Card played\n"
    "  300 pts for each Gotcha!\n"
    "  300 pts for playing all 4 Power Cards\n"
    "  500 pts if opponent travels 0km       "
};

resource rTextForLETextBox2(0x42012, $0000) {
    TBForeColor TBColor7
    "How to Win"
    TBForeColor TBColor0
    ": pass 5000 points at\n"
    "  the end of a rally.  If both players\n"
    "  pass, the high score wins.  In case of\n"
    "  a tie, another rally is played to break\n"
    "  the tie."
};

resource rTextForLETextBox2(0x42013, $0000) {
    TBForeColor TBColor7
    "Strategy Hints"
    TBForeColor TBColor0
    ":\n"
    "  Keep track of what's been played or\n"
    "discarded.  Once you've seen both Crash\n"
    "cards, for example, Repairs cards are\n"
    "worthless.\n"
    "  Save Power Cards for Gotchas!, but\n"
    "play them if the ][gs gets close to the\n"
    "1500km checkpoint.\n"
    "  Plan ahead - remember you must reach\n"
    "checkpoints EXACTLY. That 50km card\n"
    "you discarded may come back to haunt\n"
    "you."
};

resource rTextForLETextBox2(0x42014, $0000) {
    TBForeColor TBColor7
    "Game Menu"
    TBForeColor TBColor0
    "\n"
    "  "
    TBForeColor TBColor2
    "Start Game"
    TBForeColor TBColor0
    " begins a new game.\n"
    "It is disabled if a player name has not\n"
    "been entered.\n"
    "  "
    TBForeColor TBColor2
    "Abort Game"
    TBForeColor TBColor0
    " aborts the current\n"
    "game, and doesn't include it in the\n"
    "Hall of Fame. The ][gs usually begs you\n"
    "to reconsider.\n"
    "  "
    TBForeColor TBColor2
    "Quit"
    TBForeColor TBColor0
    " exits the program. If a\n"
    "game is in progress, it will be saved.     "
};

resource rTextForLETextBox2(0x42015, $0000) {
    TBForeColor TBColor7
    "Edit Menu"
    TBForeColor TBColor0
    "\n"
    "  This is disabled unless used by an\n"
    "NDA.  I can't see why you'd need it, but\n"
    "there it is anyway."
};

resource rTextForLETextBox2(0x42016, $0000) {
    TBForeColor TBColor7
    "Info Menu"
    TBForeColor TBColor0
    "\n"
    "  "
    TBForeColor TBColor2
    "This Rally"
    TBForeColor TBColor0
    " shows the points\n"
    "earned for the current rally, the\n"
    "current checkpoint (1500km or 2000km),\n"
    "and how many cards remain in the deck.\n"
    "  "
    TBForeColor TBColor2
    "This game"
    TBForeColor TBColor0
    " shows the current\n"
    "score as of the last completed rally.\n"
    "The current rally's points are NOT\n"
    "included.\n"
    "  "
    TBForeColor TBColor2
    "Player"
    TBForeColor TBColor0
    " allows you to enter your\n"
    "name, so that your record can be in the\n"
    "Hall of Fame."
};

resource rTextForLETextBox2(0x42017, $0000) {
    TBLeftJust
    TBLeftMargin "\$00\$00"
    "\$01R" "\$04\$00"
    TBFont TBShaston "\$00\$08"
    TBForeColor TBColor7
    TBBackColor TBColorF
    "The Hall of Fame"
    TBFont TBShaston "\$00\$08"
    TBForeColor TBColor0
    TBBackColor TBColorF
    " lists the ten\n"
    "  best players, their win-loss records,\n"
    "  and their average point spread.  Your\n"
    "  rank is based on total, not average,\n"
    "  point spread.  \n"
    "The other options toggle the sound\n"
    "  and an onscreen count of cards left\n"
    "  in the deck.\n"
    "The Hall of Fame is stored in the file\n"
    "  MSHOF.  To restart it, delete this file."
    TBFont TBShaston "\$00\$08"
    TBForeColor TBColor7
    TBBackColor TBColorF
};

resource rTextForLETextBox2(0x42018, $0000) {
