/* picstats */
type 0x0ba7 {
	array Entries {
		integer; /* width */
		integer; /* right */
		integer; /* bottom */
	};
};


/* ssrec */
type 0x3BA6 {
	array Entries {
		integer; /* size */
		integer; /* rate */
		integer; /* volume */
		integer; /* channel */
	};
};


